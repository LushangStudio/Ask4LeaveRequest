# Demo only. Production identity integration is intentionally not implemented.
APP_MODE=demo
DATABASE_URL=sqlite:///./var/leave.db
# MySQL alternative (URL-encode password):
# DATABASE_URL=mysql+pymysql://ask4leave:CHANGE_ME@127.0.0.1:3306/ask4leave?charset=utf8mb4
# Required for fully embedded Chinese PDF text; example on Ubuntu:
PDF_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc
# Optional document faces. Keep the font files in a persistent directory on the server.
# PDF_TITLE_FONT_PATH=/etc/ask4leave/fonts/FZXiaoBiaoSong.ttf
# PDF_BODY_FONT_PATH=/etc/ask4leave/fonts/FangSong_GB2312.ttf
